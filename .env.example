# ---- Brain ------------------------------------------------------------
# auto   = Claude if ANTHROPIC_API_KEY is set, else Groq if GROQ_API_KEY is set,
#          else free local Ollama
# groq   = free and FAST, runs online (free key: https://console.groq.com/keys)
# ollama = free, runs on your computer (slower on older machines; https://ollama.com)
# claude = paid, smartest (needs Anthropic API key)
GROOT_BRAIN=auto

# Free, fast option: paste your free Groq key here
GROQ_API_KEY=
# Leave empty to pick a working Groq model automatically
GROOT_GROQ_MODEL=

# Local option: use llama3.2:1b if llama3.2 is too slow on your computer
GROOT_OLLAMA_MODEL=llama3.2

# Optional: Claude API key from https://console.anthropic.com (leave empty for free mode)
ANTHROPIC_API_KEY=
GROOT_MODEL=claude-sonnet-5-5

# ---- Other settings ---------------------------------------------------
GROOT_NAME=Groot
GROOT_WAKE_WORDS=hey groot,groot
GROOT_USE_WAKE_WORD=true
# google (free, online) or whisper (free, offline, needs: pip install openai-whisper)
GROOT_STT=google
GROOT_WHISPER_MODEL=base
GROOT_VOICE_RATE=180
# Voice engine: edge = natural neural voice (free, needs internet), mac = built-in Mac voices
GROOT_TTS=edge
# Natural voice to use (list them with: edge-tts --list-voices)
GROOT_EDGE_VOICE=en-US-AndrewNeural
# Little Groot pitch for the natural voice: +0Hz normal, +20Hz little Groot, +35Hz even smaller
GROOT_EDGE_PITCH=+20Hz
# Little Groot voice (Mac). Set to false for the normal voice
GROOT_TREE_VOICE=true
# Voice pitch: higher number = smaller, cuter voice (1.0 = normal, 1.25 = little Groot, 0.8 = big deep Groot)
GROOT_VOICE_PITCH=1.25
# Only say "I am Groot" out loud; the real answer is shown as text
GROOT_I_AM_GROOT=false
# Mac voice name, e.g. Samantha, Daniel, Karen (list them with: say -v '?')
GROOT_VOICE=
# Desktop robot size: 0.6 = small (default), 1.0 = big
GROOT_ROBOT_SIZE=0.6
# Your home city, used for weather when you don't name one
GROOT_CITY=Dhaka

# ---- Slack (optional) -------------------------------------------------
# User OAuth Token from your Slack app (see README "Your apps, email and Slack")
SLACK_TOKEN=
