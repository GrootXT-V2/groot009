# ---- Brain ------------------------------------------------------------
# auto   = Claude if ANTHROPIC_API_KEY is set, else Groq if GROQ_API_KEY is set,
#          else free local Ollama
# gemini = direct Google Gemini (GEMINI_API_KEY required)
# openrouter = OpenRouter (OPENROUTER_API_KEY required)
# groq   = free and FAST, runs online (free key: https://console.groq.com/keys)
# ollama = free, runs on your computer (slower on older machines; https://ollama.com)
# claude = paid, smartest (needs Anthropic API key)
GROOT_BRAIN=gemini
GEMINI_API_KEY=
GROOT_GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_API_KEY=
GROOT_OPENROUTER_MODEL=apodex/apodex-1.1-mini:free

# Free, fast option: paste your free Groq key here
GROQ_API_KEY=
# Leave empty to pick a working Groq model automatically
GROOT_GROQ_MODEL=

# Local option: use llama3.2:1b if llama3.2 is too slow on your computer
GROOT_OLLAMA_MODEL=llama3.2

# Optional: Claude API key from https://console.anthropic.com (leave empty for free mode)
ANTHROPIC_API_KEY=
GROOT_MODEL=claude-sonnet-5-5

# ---- Other settings ---------------------------------------------------
GROOT_NAME=Kurama
GROOT_WAKE_WORDS=fox,hey fox,hay fox,foxy,hi foxy,kurama,hey kurama,nine tails,9 tails,ফক্স,কুরামা
GROOT_USE_WAKE_WORD=true
# groq = multilingual Whisper (uses GROQ_API_KEY); google = online fallback
# whisper = offline (needs: pip install openai-whisper)
GROOT_STT=groq
GROOT_WHISPER_MODEL=base
# auto detects spoken language; use en or bn to force one language
GROOT_STT_LANGUAGE=auto
# Google fallback accepts a single language; use en-US for English
GROOT_GOOGLE_LANGUAGE=bn-BD
# Bangla text uses this voice; English keeps the selected voice preset
GROOT_BANGLA_VOICE=bn-BD-PradeepNeural
GROOT_VOICE_RATE=180
# Voice engine: edge = natural neural voice (free, needs internet), mac = built-in Mac voices
GROOT_TTS=edge
# Voice style: kurama (deep, measured), natural (real-sounding male voice), natural-female, baby (child voice),
# little (young voice pitched up), normal, or custom to use GROOT_EDGE_* below
GROOT_VOICE_STYLE=kurama
# Natural voice to use (list them with: edge-tts --list-voices)
GROOT_EDGE_VOICE=en-US-AndrewNeural
# Little Groot pitch for the natural voice: +0Hz normal, +30Hz little Groot, +45Hz even smaller
GROOT_EDGE_PITCH=+30Hz
# Act out each sentence: excited lines go up, questions rise, "..." slows down
GROOT_DRAMATIC_VOICE=false
# kurama = blunt, quietly loyal fox; friendly = warm and cheerful; baby = toddler talk; cute = very dramatic; plain = normal assistant
GROOT_PERSONALITY=kurama
# Little Groot voice (Mac). Set to false for the normal voice
GROOT_TREE_VOICE=true
# Voice pitch: higher number = smaller, cuter voice (1.0 = normal, 1.25 = little Groot, 0.8 = big deep Groot)
GROOT_VOICE_PITCH=0.85
# Only say "I am Groot" out loud; the real answer is shown as text
GROOT_I_AM_GROOT=false
# Mac voice name, e.g. Samantha, Daniel, Karen (list them with: say -v '?')
GROOT_VOICE=
# Desktop buddy look: fox (realistic red fox), flat-fox (flat illustration), cute-fox (round cartoon), tree or robot
GROOT_ROBOT_STYLE=fox
# Desktop robot size: 0.6 = small (default), 1.0 = big
GROOT_ROBOT_SIZE=0.6
# Read new Mac notifications aloud (needs Full Disk Access for Terminal)
GROOT_READ_NOTIFICATIONS=true
# Your home city, used for weather when you don't name one
GROOT_CITY=Dhaka

# ---- Slack (optional) -------------------------------------------------
# User OAuth Token from your Slack app (see README "Your apps, email and Slack")
SLACK_TOKEN=
