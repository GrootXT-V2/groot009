# Required: get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional settings
GROOT_NAME=Groot
GROOT_MODEL=claude-sonnet-5-5
GROOT_WAKE_WORDS=hey groot,groot
GROOT_USE_WAKE_WORD=true
# google (free, online) or whisper (offline, needs: pip install openai-whisper)
GROOT_STT=google
GROOT_WHISPER_MODEL=base
GROOT_VOICE_RATE=180
# Your home city, used for weather when you don't name one
GROOT_CITY=Dhaka
